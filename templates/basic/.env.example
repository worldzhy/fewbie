# Nightwatch liveness reporting (optional).
# Uncomment and fill in to enroll this application into the nightwatch
# platform heartbeat; leave them out to run standalone.
# NIGHTWATCH_REPORT_ENDPOINT=https://<nightwatch-host>
# NIGHTWATCH_APPLICATION_TOKEN=<agent token>

# Base URL for API clients generated by `fewbie gen api`.
# Browser code can only read variables prefixed with NEXT_PUBLIC_.
# NEXT_PUBLIC_BASE_URL=http://localhost:3000/api
